# 复制这个文件为 .env，然后填你自己的值。
# .env 已被 .gitignore 忽略，不会推到 GitHub。
#
# 最少只需要填 WECHATAUTO_AI_KEY；BASE/MODEL 不填就用 DeepSeek 默认值。

WECHATAUTO_AI_KEY=
WECHATAUTO_AI_BASE=https://api.deepseek.com/v1
WECHATAUTO_AI_MODEL=deepseek-chat

# 可选：系统提示词
# WECHATAUTO_AI_SYSTEM=你是微信聊天助手，用中文简短回复，不超过 80 字。
# 可选：单次请求超时（秒）
# WECHATAUTO_AI_TIMEOUT=20
